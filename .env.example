# Gmail API (OAuth client from Google Cloud Console — read + send scope)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Gmail App Password (for test_gmail.py and pipeline.py)
GMAIL_ADDRESS=
